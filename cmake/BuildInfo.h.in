#pragma once

namespace arch::buildinfo {

/// @brief Enum representing build types
enum class Type {
	/// @brief Debug build
	Debug,
	/// @brief Release build
	Release,
	/// @brief RelWithDebInfo build
	RelWithDebInfo,
	/// @brief Current build type, equal to CMAKE_BUILD_TYPE
	current = @ARCHIMEDES_BUILD_TYPE@
};

/// @brief Enum representing compiler
/// @brief Additionally tells between operating systems
enum class Compiler {
	/// @brief GCC compiler, using Linux
	gcc,
	/// @brief MSVC compiler, using Windows
	msvc,
	/// @brief Current compiler
	current = @ARCHIMEDES_COMPILER@
};

} // namespace arch