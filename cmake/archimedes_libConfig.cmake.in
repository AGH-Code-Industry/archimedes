@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/archimedes_libTargets.cmake")

set(archimedes_lib_LIBRARIES archimedes_lib::archimedes_lib)
get_target_property(archimedes_lib_INCLUDE_DIRS archimedes_lib::archimedes_lib INTERFACE_INCLUDE_DIRECTORIES)

if(NOT TARGET archimedes_lib)
	add_library(archimedes_lib ALIAS archimedes_lib::archimedes_lib)
endif()

set(archimedes_lib_FOUND TRUE)

check_required_components(archimedes_lib)